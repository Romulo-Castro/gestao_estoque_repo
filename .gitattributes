# Set default behavior to automatically normalize line endings
* text=auto

# Dart and Flutter files
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Gradle files
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf

# Android files
*.xml text eol=lf
*.kt text eol=lf
*.java text eol=lf

# Ensure Windows batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.so binary
*.jar binary
*.aar binary
*.apk binary
